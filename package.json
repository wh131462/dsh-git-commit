{
  "name": "@eternalheart/dsh-git-commit",
  "version": "2.2.0",
  "type": "module",
  "description": "One-click Git or SVN commit for DeepSeek Harness: the session's current model decides how many commits the change set becomes and names each of them, and the plugin commits over an authenticated JSON channel — no chat message, no agent turn, no command node.",
  "license": "MIT",
  "author": "EternalHeart <hao131462@qq.com>",
  "homepage": "https://github.com/wh131462/dsh-git-commit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wh131462/dsh-git-commit.git"
  },
  "bugs": {
    "url": "https://github.com/wh131462/dsh-git-commit/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "svn",
    "subversion",
    "commit",
    "smart-commit",
    "conventional-commits",
    "commitlint",
    "angular"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts build.mjs",
    "format": "biome check --write src test scripts build.mjs",
    "test": "node --import tsx --test test/*.test.js test/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "pack": "npm pack",
    "publish:npm": "npm publish --access public --registry=https://registry.npmjs.com",
    "release": "npm run pack && npm run publish:npm",
    "release:notes": "node scripts/release-notes.mjs",
    "pretest": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dsh-build-tools": "^0.2.0",
    "esbuild": "0.25.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}